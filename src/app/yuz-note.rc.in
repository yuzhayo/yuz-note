#include <windows.h>

// App icon
IDI_ICON1 ICON "@CMAKE_SOURCE_DIR@/assets/icon.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION @YUZNOTE_VERSION_COMMA@,0
  PRODUCTVERSION @YUZNOTE_VERSION_COMMA@,0
  FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
  FILEFLAGS 0x0L
  FILEOS VOS_NT_WINDOWS32
  FILETYPE VFT_APP
  FILESUBTYPE VFT2_UNKNOWN
  BEGIN
    BLOCK "StringFileInfo"
    BEGIN
      BLOCK "040904b0"
      BEGIN
        VALUE "CompanyName", "Yuzhayo"
        VALUE "FileDescription", "yuz-note — Markdown opener"
        VALUE "FileVersion", "@YUZNOTE_VERSION@"
        VALUE "InternalName", "yuz-note"
        VALUE "OriginalFilename", "yuz-note.exe"
        VALUE "ProductName", "yuz-note"
        VALUE "ProductVersion", "@YUZNOTE_VERSION@"
      END
    END
    BLOCK "VarFileInfo"
    BEGIN
      VALUE "Translation", 0x0409, 1200
    END
  END
